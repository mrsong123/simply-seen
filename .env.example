# 素见好物生产配置：复制为根.env或通过APP_CONFIG_FILE/--config选择。
# 这是数据文件，不执行shell，不展开$变量。空的必填项需要填写；可选项留空自动派生。
# 所有相对路径相对于本配置文件目录；配置和密钥不能提交Git。
SPRING_PROFILES_ACTIVE=prod
APP_DEV_MODE=false

# 站点与HTTPS：域名应先通过DNS指向部署服务器，开放80/443。
PUBLIC_STORE_URL=
# 可选，默认PUBLIC_STORE_URL/api/v1及PUBLIC_STORE_URL。
PUBLIC_API_URL=
PUBLIC_ASSET_URL=
# caddy自动HTTPS；certificate使用已有证书；external接已有HTTPS反向代理。
HTTPS_MODE=caddy
ACME_EMAIL=
TLS_CERT_PATH=
TLS_KEY_PATH=
HTTP_BIND=0.0.0.0:80
HTTPS_BIND=0.0.0.0:443
WEB_BIND=127.0.0.1:8088
APP_NETWORK_CIDR=172.30.10.0/24
# 可选，默认信任上述专用Docker网段；external模式按实际边缘代理来源填写。
TRUSTED_PROXY_CIDR=
PORT=8080
# 可选，默认http://server:PORT；不要以/结尾。
API_UPSTREAM_URL=
COMPOSE_PROJECT_NAME=simply-seen

# embedded使用项目MySQL8.4；external使用现有MySQL。
DATABASE_MODE=embedded
MYSQL_DATABASE=sujian
MYSQL_USER=sujian
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# embedded模式留空，由MYSQL_*自动派生；external模式填写标准JDBC URL与账号。
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
# 外部数据库备份客户端可选CA文件及网络，默认使用本项目Docker网络。
DATABASE_CA_PATH=
DATABASE_CLIENT_NETWORK=

# 首次生产启动管理员，已有账号不会重置。至少12位独立随机口令。
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=
SUPPORT_CONTACT=
PRIVACY_CONTACT=

# 微信小程序与支付。路径可使用默认目录，也可填其它已有PEM文件。
WX_APP_ID=
WX_APP_SECRET=
WX_LOGIN_URL=https://api.weixin.qq.com/sns/jscode2session
WX_MCH_ID=
WX_MERCHANT_SERIAL=
WX_PRIVATE_KEY_PATH=./secrets/wechat/merchant-private.pem
WX_PLATFORM_SERIAL=
WX_PLATFORM_PUBLIC_KEY_PATH=./secrets/wechat/platform-public.pem
WX_API_V3_KEY=
WX_PAY_BASE_URL=https://api.mch.weixin.qq.com
# native默认扫码；h5在移动网页跳转微信H5，均需商户开通对应产品。
WX_WEB_PAYMENT_MODE=native
# 可选，网页支付产品若使用不同AppID填写；留空回退WX_APP_ID。
WX_NATIVE_APP_ID=
WX_H5_APP_ID=
WX_H5_APP_NAME=素见好物
WX_H5_ALLOWED_HOSTS=wx.tenpay.com
# 可选，默认PUBLIC_API_URL/callbacks/wechat/{pay,refund,transfer}。
WX_PAY_NOTIFY_URL=
WX_REFUND_NOTIFY_URL=
WX_TRANSFER_BASE_URL=https://api.mch.weixin.qq.com
WX_TRANSFER_NOTIFY_URL=
WX_TRANSFER_SCENE_ID=
WX_TRANSFER_PERCEPTION=
# 开通转账时填该场景实际要求的JSON数组，字段info_type/info_content，不执行shell。
WX_TRANSFER_REPORT_INFOS=

# 短信登录与姓名/身份证二要素核验，生产只允许aliyun。
SMS_PROVIDER=aliyun
SMS_API_URL=https://dysmsapi.aliyuncs.com/
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_REGION_ID=cn-hangzhou
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_DAILY_LIMIT=1000
IDENTITY_PROVIDER=aliyun
IDENTITY_API_URL=https://cloudauth.aliyuncs.com/
IDENTITY_ACCESS_KEY_ID=
IDENTITY_ACCESS_KEY_SECRET=
IDENTITY_REGION_ID=cn-hangzhou
IDENTITY_MAX_ATTEMPTS_PER_DAY=5
IDENTITY_PENDING_TTL_SECONDS=120
IDENTITY_RETRY_AFTER_SECONDS=60
# 安全随机32字节的Base64编码，跨重启/扩容/恢复保持一致，单独安全备份。
ACCOUNT_DATA_KEY=
IDENTITY_REQUIRED_FOR_WITHDRAWAL=true

# 业务开关；启用前配置相应产品/预算并由后台双人审批规则。
DISTRIBUTION_ENABLED=false
MONTHLY_ENABLED=false
TRANSFER_ENABLED=false
WITHDRAW_MIN_FEN=1000
WITHDRAW_MAX_FEN=200000

# 可选物流轨迹；留空时支持发货/运单展示，不生成虚假轨迹。
LOGISTICS_QUERY_URL=
LOGISTICS_CUSTOMER=
LOGISTICS_KEY=
LOGISTICS_CARRIER_CODES=

# 运行参数；CORS留空用于同域部署，跨域时填逗号分隔的可信Origin。
CORS_ORIGINS=
SESSION_HOURS=168
ORDER_EXPIRE_MINUTES=15
JOB_INTERVAL_MS=10000
MAINTENANCE_INTERVAL_MS=60000
JOB_INITIAL_DELAY_MS=10000
API_DOCS_ENABLED=false
# 容器非敏感JVM参数。不能放业务密钥，JVM可能打印此变量。
JDK_JAVA_OPTIONS=
# 单独运行JAR用JSON参数数组，Windows路径需JSON转义；不要放业务密钥。
JAVA_OPTS_JSON=[]

# 运维路径；BACKUP_DIR不在Git内，restore需另行显式确认。
BACKUP_DIR=./backups
# 可选构建缓存/设置；不是业务运行所需。
SUJIAN_TOOLS_DIR=
MAVEN_SETTINGS=

# 可选文件传值：不要同时填同级非空直接值。例：取消下方注释后保持对应直接值空。
# MYSQL_PASSWORD_FILE=./secrets/mysql-password.txt
# MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql-root-password.txt
# ADMIN_BOOTSTRAP_PASSWORD_FILE=./secrets/admin-password.txt
# WX_APP_SECRET_FILE=./secrets/wechat/app-secret.txt
# WX_API_V3_KEY_FILE=./secrets/wechat/api-v3-key.txt
# SMS_ACCESS_KEY_SECRET_FILE=./secrets/sms-secret.txt
# IDENTITY_ACCESS_KEY_SECRET_FILE=./secrets/identity-secret.txt
# ACCOUNT_DATA_KEY_FILE=./secrets/account-data-key.txt
