# 生产部署配置清单；本地IDE/Maven启动默认local，无需复制本文件。
SPRING_PROFILES_ACTIVE=prod
# 生产必须false；prod profile即使误设true也不会启用模拟。
APP_DEV_MODE=false
PORT=8080
DATABASE_URL=jdbc:mysql://mysql:3306/sujian?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia%2FShanghai&sslMode=REQUIRED
DATABASE_USER=sujian
DATABASE_PASSWORD=
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=
# 仅local未指定口令且管理员为空时生成私有凭据文件
APP_BOOTSTRAP_CREDENTIALS_PATH=./data/bootstrap-admin.txt
SESSION_HOURS=168
ORDER_EXPIRE_MINUTES=15
JOB_INTERVAL_MS=10000
MAINTENANCE_INTERVAL_MS=60000
JOB_INITIAL_DELAY_MS=10000
API_DOCS_ENABLED=false
CORS_ORIGINS=
SUPPORT_CONTACT=
PRIVACY_CONTACT=
PUBLIC_STORE_URL=
DISTRIBUTION_ENABLED=false
MONTHLY_ENABLED=false
TRANSFER_ENABLED=false
WITHDRAW_MIN_FEN=1000
WITHDRAW_MAX_FEN=200000
# 手机登录与姓名/身份证二要素实名认证；生产必须aliyun，不允许development
SMS_PROVIDER=aliyun
SMS_API_URL=https://dysmsapi.aliyuncs.com/
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_REGION_ID=cn-hangzhou
SMS_SIGN_NAME=
# 审核通过的验证码模板，包含${code}变量
SMS_TEMPLATE_CODE=
SMS_DAILY_LIMIT=1000
IDENTITY_PROVIDER=aliyun
IDENTITY_API_URL=https://cloudauth.aliyuncs.com/
IDENTITY_ACCESS_KEY_ID=
IDENTITY_ACCESS_KEY_SECRET=
IDENTITY_REGION_ID=cn-hangzhou
IDENTITY_MAX_ATTEMPTS_PER_DAY=5
IDENTITY_PENDING_TTL_SECONDS=120
IDENTITY_RETRY_AFTER_SECONDS=60
# 32字节安全随机密钥的Base64；长期保留，不能每次部署重新生成
ACCOUNT_DATA_KEY=
# 仅development且未设置ACCOUNT_DATA_KEY时生成并复用私有文件
ACCOUNT_DATA_KEY_PATH=./data/account-data.key
# 生产始终强制实名；false只供隔离的开发/历史测试
IDENTITY_REQUIRED_FOR_WITHDRAWAL=true
WX_APP_ID=
WX_APP_SECRET=
WX_LOGIN_URL=https://api.weixin.qq.com/sns/jscode2session
WX_MCH_ID=
WX_MERCHANT_SERIAL=
WX_PRIVATE_KEY_PATH=/run/secrets/wechat/merchant-private.pem
WX_PLATFORM_SERIAL=
WX_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/wechat/platform-public.pem
WX_API_V3_KEY=
WX_PAY_BASE_URL=https://api.mch.weixin.qq.com
WX_PAY_NOTIFY_URL=
WX_REFUND_NOTIFY_URL=
WX_TRANSFER_BASE_URL=https://api.mch.weixin.qq.com
WX_TRANSFER_NOTIFY_URL=
WX_TRANSFER_SCENE_ID=
WX_TRANSFER_PERCEPTION=
WX_TRANSFER_REPORT_INFOS=
# Docker配置
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sujian
MYSQL_USER=sujian
MYSQL_PASSWORD=
WEB_BIND=127.0.0.1:8088
API_UPSTREAM_URL=http://server:8080
# 外层HTTPS代理的可信来源地址；不要配置0.0.0.0/0或信任任意客户端
TRUSTED_PROXY_CIDR=127.0.0.1/32
# 物流轨迹：快递100实时查询协议；未配置时仍支持发货与运单展示
LOGISTICS_QUERY_URL=
LOGISTICS_CUSTOMER=
LOGISTICS_KEY=
LOGISTICS_CARRIER_CODES=
