# 素见好物 · 生产配置文件（逐项中文注释版）
# 用法：复制本文件为项目根目录.env，只填写等号右侧，参数英文名不要修改。
# 已有.env时先备份并补齐需要的值，不要用空模板覆盖现有真实配置。
# [必填]/[必需文件]必须提供；[条件必填]按当前模式填写；[自动]留空；[默认]/[固定]保持即可。
# 默认方案：内置MySQL + 自动HTTPS + 网页扫码支付；可按注释切换已有数据库/证书/H5。
# 文件使用UTF-8；路径相对于本文件；支持中文/JSON，引号内#按原文处理，不执行shell。
# 文件与真实密钥均不要提交Git或发送到聊天；一份根.env同时用于后端、网页、小程序和部署。
# 填完：python3 scripts/manage.py check，然后python3 scripts/manage.py up。
# Windows把python3替换为py -3。完整参数说明见docs/configuration.md。

# ==================== 一、固定生产开关 ====================

# [固定] Spring运行环境：生产必须为prod，保持默认。
SPRING_PROFILES_ACTIVE=prod

# [固定] 开发模拟开关：生产必须为false，禁止启用模拟登录、付款或实名。
APP_DEV_MODE=false

# ==================== 二、站点域名与HTTPS ====================

# [必填] 商城公网域名：填写完整HTTPS站点根地址，例如https://mall.example.com。
# 不带/api、不带子目录或查询参数；默认内置HTTPS使用443端口。
PUBLIC_STORE_URL=

# [自动] 公网API地址：同域部署留空，自动使用PUBLIC_STORE_URL/api/v1。
# API单独部署在其他HTTPS域名时填写完整API前缀；网页仍经同域/api访问，内部转发另配API_UPSTREAM_URL。
PUBLIC_API_URL=

# [自动] 公网素材地址：留空使用PUBLIC_STORE_URL；独立素材域名时填写HTTPS根地址。
PUBLIC_ASSET_URL=

# [默认] HTTPS部署方式：caddy=自动证书；certificate=已有证书；external=已有HTTPS代理。
# 默认caddy只需提供站点域名与ACME_EMAIL，并先配置DNS、开放80/443。
HTTPS_MODE=caddy

# [条件必填] 证书通知邮箱：HTTPS_MODE=caddy时填写实际邮箱，用于证书申请和续签通知。
ACME_EMAIL=

# [条件必填] 站点HTTPS证书链文件：仅certificate模式填写，例如./secrets/tls/fullchain.pem。
TLS_CERT_PATH=

# [条件必填] 站点HTTPS私钥文件：仅certificate模式填写，例如./secrets/tls/privkey.pem。
TLS_KEY_PATH=

# [默认] 服务器HTTP监听地址：0.0.0.0:80，对外接收HTTP并由HTTPS入口处理。
HTTP_BIND=0.0.0.0:80

# [默认] 服务器HTTPS监听地址：0.0.0.0:443，对外提供HTTPS。
HTTPS_BIND=0.0.0.0:443

# [默认] Nginx内部监听地址：127.0.0.1:8088；external模式的现有代理转发到此地址。
WEB_BIND=127.0.0.1:8088

# [默认] 本项目Docker私有IPv4网段：无冲突时保持默认；冲突才换其他私有网段。
APP_NETWORK_CIDR=172.30.10.0/24

# [自动] 可信反向代理来源网段：留空使用APP_NETWORK_CIDR。
# external模式按实际代理来源填写；不能使用0.0.0.0/0或::/0。
TRUSTED_PROXY_CIDR=

# [默认] Java服务内部端口：8080；健康检查会跟随，API_UPSTREAM_URL留空时内部代理也自动跟随。
PORT=8080

# [自动] Nginx到Java的内部地址：留空自动使用http://server:PORT。
# 普通部署不填；自定义时不能带路径、查询参数或尾部斜杠。
API_UPSTREAM_URL=

# [默认] Docker项目名称：用于标识容器、网络和数据卷；有正式数据后保持不变。
COMPOSE_PROJECT_NAME=simply-seen

# ==================== 三、数据库（二选一；默认内置MySQL） ====================

# [默认] 数据库方式：embedded=本项目启动MySQL8.4；external=连接已有MySQL。
DATABASE_MODE=embedded

# [默认] 内置MySQL数据库名：embedded模式使用，保持sujian即可。
MYSQL_DATABASE=sujian

# [默认] 内置MySQL应用账号：embedded模式使用，不是root账号。
MYSQL_USER=sujian

# [条件必填] 内置MySQL应用账号密码：embedded模式填写独立随机密码。
# 建议24位以上；也可留空并启用下方MYSQL_PASSWORD_FILE。
MYSQL_PASSWORD=

# [条件必填] 内置MySQL超级管理员密码：embedded模式填写，与应用账号密码分开。
MYSQL_ROOT_PASSWORD=

# [条件必填] 外部MySQL JDBC连接：external模式填写；embedded模式留空自动生成。
# 格式示例：jdbc:mysql://db.example.com:3306/sujian?sslMode=VERIFY_IDENTITY&serverTimezone=Asia%2FShanghai
# 不把账号密码写进URL，分别填写下面两个参数。
DATABASE_URL=

# [条件必填] 外部MySQL账号：external模式填写；embedded模式留空使用MYSQL_USER。
DATABASE_USER=

# [条件必填] 外部MySQL密码：external模式填写；embedded模式留空使用MYSQL_PASSWORD。
DATABASE_PASSWORD=

# [可选] 外部数据库私有CA文件：例如./secrets/database/ca.pem。
# 使用私有数据库CA时配置，并将JDBC sslMode设为VERIFY_IDENTITY或VERIFY_CA。
DATABASE_CA_PATH=

# [可选] 外部数据库备份客户端所在Docker网络：通常留空，使用本项目网络。
DATABASE_CLIENT_NETWORK=

# ==================== 四、管理员与对外联系方式 ====================

# [默认] 首个管理员登录账号：admin；可在首次部署前修改。
ADMIN_BOOTSTRAP_USER=admin

# [必填] 首个管理员登录密码：至少12位，建议独立的24至48位随机口令。
# 已有管理员不会被该值重置；配置检查仍需要此项，首次启动后也要保留。
ADMIN_BOOTSTRAP_PASSWORD=

# [必填] 对外客服联系方式：填写用户能联系到的电话、邮箱或客服微信。
SUPPORT_CONTACT=

# [必填] 隐私事务联系方式：用于个人信息查询/更正/删除申请，填写实际邮箱或电话。
PRIVACY_CONTACT=

# ==================== 五、微信登录、支付与商家转账 ====================

# [必填] 微信小程序AppID：从小程序后台“开发管理/开发设置”获取，wx开头共18位。
# 必须与收款商户号完成关联；不是商户号，也不是AppSecret。
WX_APP_ID=

# [必填] 微信小程序AppSecret：与WX_APP_ID对应，在小程序后台获取；仅服务端使用。
WX_APP_SECRET=

# [默认] 微信code换登录身份的官方接口：保持默认。
WX_LOGIN_URL=https://api.weixin.qq.com/sns/jscode2session

# [必填] 微信支付商户号mchid：从微信支付商户平台获取；不是小程序AppID。
WX_MCH_ID=

# [必填] 商户API证书序列号：从商户平台API证书查看。
# 必须对应下面商户私钥；不要填成微信支付平台证书序列号或平台公钥ID。
WX_MERCHANT_SERIAL=

# [必需文件] 商户签名RSA私钥：通常是申请商户API证书时生成的apiclient_key.pem。
# 可以把该文件复制为默认路径，或修改为实际私钥路径；不要填apiclient_cert.pem。
WX_PRIVATE_KEY_PATH=./secrets/wechat/merchant-private.pem

# [必填] 微信支付平台公钥ID或平台证书序列号：必须与下方平台文件配对。
# 使用平台公钥时通常为PUB_KEY_ID_开头的ID；使用平台证书时填写该平台证书序列号。
WX_PLATFORM_SERIAL=

# [必需文件] 微信支付平台RSA公钥或平台证书：用于验签及加密转账姓名。
# 从微信支付平台公钥/平台证书渠道获取；不能使用你的商户私钥或商户API证书。
WX_PLATFORM_PUBLIC_KEY_PATH=./secrets/wechat/platform-public.pem

# [必填] 微信支付APIv3密钥：从商户平台“API安全/APIv3密钥”设置，恰好32字节。
# 通常为32个ASCII字符；不是AppSecret，也不是本系统ACCOUNT_DATA_KEY。
WX_API_V3_KEY=

# [默认] 微信支付官方API根地址：保持默认。
WX_PAY_BASE_URL=https://api.mch.weixin.qq.com

# [默认] 网页付款方式：native=扫码；h5=移动网页使用H5、桌面仍可扫码。
# 选择的支付产品须在微信商户平台开通；小程序支付独立使用JSAPI。
WX_WEB_PAYMENT_MODE=native

# [条件填写] Native扫码支付AppID：使用不同应用时填写；留空使用WX_APP_ID。
# 填写的应用须与WX_MCH_ID关联并具备对应产品权限。
WX_NATIVE_APP_ID=

# [条件填写] 微信H5支付AppID：使用不同应用时填写；留空使用WX_APP_ID。
# 选择h5时还需在商户平台配置实际H5支付域名。
WX_H5_APP_ID=

# [默认] H5支付展示的网站名称：可改为你的正式品牌名称。
WX_H5_APP_NAME=素见好物

# [默认] 允许的H5支付跳转主机：默认微信支付官方wx.tenpay.com。
# 多个主机用逗号分隔；不填写协议、路径或任意第三方域名。
WX_H5_ALLOWED_HOSTS=wx.tenpay.com

# [自动] 支付成功回调：留空使用PUBLIC_API_URL/callbacks/wechat/pay。
WX_PAY_NOTIFY_URL=

# [自动] 退款回调：留空使用PUBLIC_API_URL/callbacks/wechat/refund。
WX_REFUND_NOTIFY_URL=

# [默认] 微信商家转账官方API根地址：保持默认。
WX_TRANSFER_BASE_URL=https://api.mch.weixin.qq.com

# [自动] 转账回调：留空使用PUBLIC_API_URL/callbacks/wechat/transfer。
WX_TRANSFER_NOTIFY_URL=

# [条件必填] 商家转账场景ID：仅TRANSFER_ENABLED=true时填写商户已开通的实际场景。
WX_TRANSFER_SCENE_ID=

# [条件必填] 收款人感知文案：仅启用转账时填写该场景允许的实际文案。
WX_TRANSFER_PERCEPTION=

# [条件必填] 转账场景上报信息：仅启用转账时填写商户场景要求的非空JSON数组。
# 格式为[{"info_type":"实际字段名称","info_content":"实际字段内容"}]，字段按商户平台要求填写。
# 建议用单引号包住整个JSON；未启用转账时留空，不要填写示例文案。
WX_TRANSFER_REPORT_INFOS=

# ==================== 六、手机号验证码（阿里云短信） ====================

# [固定] 手机验证码服务商：生产使用aliyun。
SMS_PROVIDER=aliyun

# [默认] 阿里云短信官方接口：保持默认，不添加AccessKey或其他查询参数。
SMS_API_URL=https://dysmsapi.aliyuncs.com/

# [必填] 阿里云短信AccessKey ID：使用具有短信发送权限的阿里云/RAM访问密钥。
SMS_ACCESS_KEY_ID=

# [必填] 阿里云短信AccessKey Secret：必须与上面的AccessKey ID配对。
SMS_ACCESS_KEY_SECRET=

# [默认] 短信API地域：默认cn-hangzhou。
SMS_REGION_ID=cn-hangzhou

# [必填] 阿里云短信签名名称：填写审核通过的签名原文，不是申请单号。
SMS_SIGN_NAME=

# [必填] 阿里云验证码模板CODE：填写审核通过的SMS_开头模板编码。
# 模板验证码变量必须命名为code，与本系统发送的参数一致。
SMS_TEMPLATE_CODE=

# [默认] 本系统每日验证码发送总上限：1000条；用于限制发送量，不是服务商套餐余额。
SMS_DAILY_LIMIT=1000

# ==================== 七、实名认证与本系统资料加密 ====================

# [固定] 姓名/身份证二要素核验服务商：生产使用aliyun。
IDENTITY_PROVIDER=aliyun

# [默认] 阿里云实名认证官方接口：保持默认，不添加密钥或查询参数。
IDENTITY_API_URL=https://cloudauth.aliyuncs.com/

# [必填] 阿里云实名认证AccessKey ID：须开通并有权调用Id2MetaVerify。
# 即使暂时关闭转账，生产启动仍要求配置此服务。
IDENTITY_ACCESS_KEY_ID=

# [必填] 阿里云实名认证AccessKey Secret：必须与上面的实名AccessKey ID配对。
# 与短信共用密钥时，分别填写相同的实际值，并确保该密钥同时具有两项权限。
IDENTITY_ACCESS_KEY_SECRET=

# [默认] 实名API地域：默认cn-hangzhou。
IDENTITY_REGION_ID=cn-hangzhou

# [默认] 每会员每天实名核验上限：5次，可设1至10。
IDENTITY_MAX_ATTEMPTS_PER_DAY=5

# [默认] 实名处理中租约时长：120秒，可设60至600。
IDENTITY_PENDING_TTL_SECONDS=120

# [默认] 实名失败后重试间隔：60秒，可设30至300。
IDENTITY_RETRY_AFTER_SECONDS=60

# [必填] 本系统账户资料加密密钥：独立随机32字节，再Base64编码，通常44个字符。
# 首次生成：python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Windows把python3换成py -3。只生成一次；重启、扩容、恢复必须保持相同并独立备份。
# 不可用WX_API_V3_KEY或AppSecret替代；也可使用ACCOUNT_DATA_KEY_FILE。
ACCOUNT_DATA_KEY=

# [固定] 提现实名认证门禁：保持true，生产不能通过false绕过真实核验。
IDENTITY_REQUIRED_FOR_WITHDRAWAL=true

# ==================== 八、业务开关（分销、月度活动、提现均默认关闭） ====================

# [按需开启] 二级成交分销开关：false关闭；需要启用时设为true并重新运行manage.py up。
# 环境开关生效后，在后台创建启用分销的规则并由另一管理员审批；已有规则不会被自动改写。
DISTRIBUTION_ENABLED=false

# [按需开启] 月度奖励活动开关：false关闭；需要运营月度活动时改为true并设置预算/审批。
MONTHLY_ENABLED=false

# [按需开启] 提现及真实商家转账开关：false关闭。
# 商户开通转账且填好场景ID、感知文案、上报JSON后改为true；转账仍须独立审核和执行。
TRANSFER_ENABLED=false

# [默认] 最低税前提现金额，单位分：1000分=10元。
WITHDRAW_MIN_FEN=1000

# [默认] 最高单笔税前提现金额，单位分：200000分=2000元。
# 实际仍受商户权限与渠道限额约束。
WITHDRAW_MAX_FEN=200000

# ==================== 九、物流轨迹（可选） ====================

# [可选] 快递100轨迹查询完整HTTPS接口：留空不查询轨迹，仍能发货和展示运单。
# 使用快递100实时查询服务时填写https://poll.kuaidi100.com/poll/query.do，并填下方三项。
LOGISTICS_QUERY_URL=

# [条件必填] 快递100客户编号customer：仅配置物流查询接口后填写。
LOGISTICS_CUSTOMER=

# [条件必填] 快递100授权密钥key：仅配置物流查询接口后填写。
LOGISTICS_KEY=

# [条件必填] 物流公司名称到快递100编码的JSON映射：仅开启轨迹查询时填写。
# 示例格式：{"顺丰速运":"shunfeng","中通快递":"zhongtong"}；名称与后台发货选用的名称一致。
LOGISTICS_CARRIER_CODES=

# ==================== 十、运行参数（通常无需改动） ====================

# [可选] 跨域访问白名单：网页与API同域留空；跨域填写实际HTTPS网页Origin，多个用逗号分隔。
CORS_ORIGINS=

# [默认] 登录会话有效期：168小时，即7天。
SESSION_HOURS=168

# [默认] 未付款订单有效期：15分钟，超时后由任务关单并释放预占。
ORDER_EXPIRE_MINUTES=15

# [默认] 持久异步任务扫描间隔，单位毫秒：10000=10秒。
JOB_INTERVAL_MS=10000

# [默认] 订单维护与佣金结算扫描间隔，单位毫秒：60000=60秒。
MAINTENANCE_INTERVAL_MS=60000

# [默认] 后台任务首次扫描延迟，单位毫秒：10000=10秒。
JOB_INITIAL_DELAY_MS=10000

# [默认] 在线Swagger接口文档开关：生产保持false；源码内仍有静态API文档。
API_DOCS_ENABLED=false

# [可选] 容器Java内存等非敏感参数：留空即可；示例-Xms128m -Xmx512m。
# JVM可能打印此变量，不放密码、证件或业务密钥。
JDK_JAVA_OPTIONS=

# [默认] 单独运行JAR的非敏感JVM参数JSON数组：默认[]。
# 此参数用于manage.py run，不是Docker内存配置；通常无需修改。
JAVA_OPTS_JSON=[]

# ==================== 十一、备份与构建路径 ====================

# [默认] 数据库备份输出目录：相对于此配置文件，默认./backups。
BACKUP_DIR=./backups

# [可选] Maven等工具缓存目录：留空使用启动器默认位置，不是业务密钥目录。
SUJIAN_TOOLS_DIR=

# [可选] 自定义Maven settings.xml文件路径：正常依赖网络环境留空。
MAVEN_SETTINGS=

# ==================== 十二、可选：用文件传递敏感值 ====================
# 以下仅是可取消注释的配置写法，不要求全部创建。
# 启用某个XXX_FILE时，保持上面同名XXX的直接值为空；文件内只写实际值，不写XXX=。
# 文件使用UTF-8，最多64KiB，可有末尾一个换行；文件路径同样相对于本配置文件。
# 商户私钥/平台公钥仍使用上方两个*_PATH，不通过此处*_FILE替代。

# [可选文件] 内置MySQL应用账号密码文件。
# MYSQL_PASSWORD_FILE=./secrets/mysql-password.txt
# [可选文件] 内置MySQL超级管理员密码文件。
# MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql-root-password.txt
# [可选文件] 首个管理员登录密码文件。
# ADMIN_BOOTSTRAP_PASSWORD_FILE=./secrets/admin-password.txt
# [可选文件] 小程序AppSecret文件。
# WX_APP_SECRET_FILE=./secrets/wechat/app-secret.txt
# [可选文件] 微信支付APIv3密钥文件（32字节原文，不是Base64账户密钥）。
# WX_API_V3_KEY_FILE=./secrets/wechat/api-v3-key.txt
# [可选文件] 阿里云短信AccessKey Secret文件。
# SMS_ACCESS_KEY_SECRET_FILE=./secrets/sms-secret.txt
# [可选文件] 阿里云实名AccessKey Secret文件。
# IDENTITY_ACCESS_KEY_SECRET_FILE=./secrets/identity-secret.txt
# [可选文件] 本系统账户加密密钥文件（32随机字节的Base64编码）。
# ACCOUNT_DATA_KEY_FILE=./secrets/account-data-key.txt
